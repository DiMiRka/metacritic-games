# Настройки сервиса, скопировать в .env и заполнить (команда cp .env.example .env)
# Перед запуском на сервере обязательно задать всё, что помечено [обязательно в prod]
# Пустое значение = умолчание из app/core/config.py


# ============================================================================
# Окружение
# ============================================================================

# dev или prod. В prod (cookie только по HTTPS, /docs и /openapi.json выключены, Caddy ставит HSTS)
ENV=dev

# Домен сайта, на него Caddy сам выпустит HTTPS-сертификат. Локально localhost
# Без своего домена подойдёт IP через sslip.io, например 203-0-113-10.sslip.io
DOMAIN=localhost

# Часовой пояс суток обхода, расписания, очистки и бэкапов
TIMEZONE=Europe/Moscow


# ============================================================================
# Секреты web
# ============================================================================

# [обязательно в prod] Ключ HMAC для CSRF и шифрования секретов TOTP (openssl rand -hex 32)
# Хранить копию вне сервера: без него секреты TOTP из базы и бэкапов не расшифровать
SECRET_KEY=
# Смена ключа: новый в SECRET_KEY, прежний сюда (несколько через запятую), перезапустить web,
# он перешифрует секреты TOTP, затем очистить
SECRET_KEY_PREVIOUS=


# ============================================================================
# База данных
# ============================================================================

# [обязательно в prod] Владелец схемы (им работают только migrate и backup)
POSTGRES_USER=metacritic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metacritic

# [обязательно в prod] Роли с минимальными правами для web и worker, их создаёт
# python -m app db-roles (сервис migrate). Пароли без спецсимволов URL (openssl rand -hex 24)
APP_WEB_DB_PASSWORD=change-me-web
APP_WORKER_DB_PASSWORD=change-me-worker

# Только для запуска вне Docker (uvicorn, тесты, CLI): пароль тот же, что POSTGRES_PASSWORD
# В compose у каждого сервиса свой адрес с хостом db и своей ролью
DATABASE_URL=postgresql+asyncpg://metacritic:change-me@localhost:5432/metacritic


# ============================================================================
# Вход в служебную часть
# ============================================================================
# Пользователей создаёт python -m app users create-admin <login>

# Срок жизни сессии и закрытие при бездействии (0 только срок жизни)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Неудачи с одного IP под одним логином (после LOGIN_MAX_ATTEMPTS вход с этого IP закрыт на окно)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Неудачи под одним логином с любых IP (после LOGIN_DELAY_AFTER каждая попытка ждёт 2, 4, 8…
# секунд, но не больше LOGIN_DELAY_MAX_SECONDS). Это задержка, а не блокировка
# На каждой LOGIN_ALERT_THRESHOLD-й неудаче предупреждение в журнал, серии видны в мониторе
LOGIN_DELAY_AFTER=5
LOGIN_DELAY_MAX_SECONDS=60
LOGIN_ALERT_THRESHOLD=10

# Второй фактор TOTP для администраторов (python -m app users totp <login> включает,
# users totp-off выключает). Если стоит true: администратор без TOTP не войдёт вовсе,
# инчае сразу логиним без проверки кода
ADMIN_TOTP_REQUIRED=false
# Код вводится отдельным шагом после пароля (секунд на ввод и неверных кодов до повторного пароля)
LOGIN_CODE_TTL_SECONDS=300
LOGIN_CODE_MAX_ATTEMPTS=5


# ============================================================================
# Ограничение частоты запросов
# ============================================================================
# Запросов в минуту с одного IP, счётчики в памяти процесса web

RATE_LIMIT_CATALOG_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=20


# ============================================================================
# Обход Metacritic
# ============================================================================

# Игр за один проход и как часто проход запускается по расписанию
BATCH_SIZE=20
CRAWL_INTERVAL_MINUTES=60
# Запустить проход сразу при старте воркера, не дожидаясь расписания
CRAWL_ON_START=true
# Кнопка «Запустить сейчас» не чаще, чем раз в столько минут после старта прошлого прохода
MANUAL_RUN_COOLDOWN_MINUTES=10

# Пауза между запросами к Metacritic в секундах
REQUEST_DELAY=1.0
# User-Agent запросов к Metacritic, по умолчанию как у обычного Chrome
# USER_AGENT=


# ============================================================================
# LLM: резюме отзывов, перевод описаний, заключения по летсплеям
# ============================================================================
# Без ключа LLM эти этапы просто не запускаются, обход работает

# Claude: LLM_PROVIDER=anthropic, ключ в ANTHROPIC_API_KEY
LLM_PROVIDER=anthropic
SUMMARY_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Любой OpenAI-совместимый провайдер (Gemini, OpenRouter, Groq, Ollama), например Gemini:
# LLM_PROVIDER=openai
# SUMMARY_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=ключ из https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=

# Запросов к LLM в минуту (0 без ограничения)
LLM_REQUESTS_PER_MINUTE=0
# Цена модели в $ за миллион токенов для оценки расходов в мониторе (0 не показывать)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0


# ============================================================================
# Эмбеддинги и похожие игры
# ============================================================================
# Модель fastembed на CPU, скачивается при первом запуске в EMBEDDING_CACHE_DIR
# После смены модели: python -m app refresh пересчитает векторы

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models


# ============================================================================
# Летсплеи: поиск на YouTube, расшифровка речи, заключение LLM
# ============================================================================
# Выполняет сервис worker-letsplay (WORKER_POOLS=letsplay). Нужны LLM и YOUTUBE_API_KEY

# Ставить ли задачи летсплеев
LETSPLAY_ENABLED=true

# Ключ YouTube Data API v3 из console.cloud.google.com: ограничьте его этим API и IP сервера
# Квота 10 000 единиц в сутки, это около 100 поисков. Когда кончается, летсплеи ждут сброса
# в полночь по тихоокеанскому времени. Без ключа летсплеи не ищутся
YOUTUBE_API_KEY=
# Файл cookies (формат Netscape), если YouTube на сервере просит подтвердить, что вы не бот
# Лучше от отдельного аккаунта: YouTube может заблокировать его за автоматические запросы
YOUTUBE_COOKIES_FILE=

# Ролики короче этого считаются трейлерами и нарезками
LETSPLAY_MIN_DURATION_MINUTES=10
# Сколько роликов пробовать по очереди, если в самом популярном нет речи
LETSPLAY_MAX_CANDIDATES=3
# Через сколько дней снова искать самый популярный ролик
LETSPLAY_REFRESH_DAYS=30

# Откуда брать речь (auto: субтитры, без них Whisper, captions: только субтитры, whisper: только Whisper)
LETSPLAY_TRANSCRIBER=auto
# Whisper слушает только начало ролика: small на 2 vCPU справляется за несколько минут
LETSPLAY_MAX_AUDIO_MINUTES=20
# Сколько символов расшифровки уходит в LLM
LETSPLAY_MAX_TRANSCRIPT_CHARS=20000
# Модель faster-whisper (tiny, base, small, medium) и потоки CPU
WHISPER_MODEL=small
WHISPER_THREADS=2


# ============================================================================
# Очередь задач и воркеры
# ============================================================================

# Имя экземпляра воркера в мониторе, пусто: пулы@hostname:pid, например letsplay@14e5b4ae2b44:1
WORKER_ID=
# Пулы этого процесса через запятую: metacritic, summarize, embed, letsplay (пусто: все)
# В compose основной worker без letsplay, а worker-letsplay только с ним
WORKER_POOLS=
# Проход по расписанию и ночная очистка: true ровно у одного воркера
WORKER_SCHEDULE=true

# Аренда задачи: если воркер не продлил её за это время, задачу заберёт другой
JOB_LEASE_SECONDS=300
# Попыток до статуса dead и пауза между повторами (удваивается до JOB_RETRY_MAX_SECONDS)
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
# Как часто проверять очередь без уведомления NOTIFY
JOB_POLL_SECONDS=5

# Одновременных задач по видам. Metacritic: один процесс-обработчик, лимит частоты в его памяти
SCRAPE_CONCURRENCY=3
SUMMARY_CONCURRENCY=2
EMBED_CONCURRENCY=1
LETSPLAY_CONCURRENCY=1

# Сколько ждать текущие задачи при остановке, stop_grace_period в compose должен быть больше
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Файл для healthcheck воркера: в compose задан сам, вне Docker не нужен
WORKER_HEALTH_FILE=


# ============================================================================
# Автоматы защиты от массового сбоя
# ============================================================================
# После стольких сбоев подряд задачи откладываются на OPEN_SECONDS без траты попыток
# Автомат youtube использует порог metacritic и время открытия llm

BREAKER_METACRITIC_THRESHOLD=5
BREAKER_METACRITIC_OPEN_SECONDS=600
BREAKER_LLM_THRESHOLD=3
BREAKER_LLM_OPEN_SECONDS=1800
# Сколько ждать результат пробной задачи после открытия
BREAKER_PROBE_SECONDS=60


# ============================================================================
# Хранение и очистка
# ============================================================================
# Ежедневно в CLEANUP_HOUR по TIMEZONE, дни хранения (0 не чистить)

# Завершённые задачи, проходы с их записями, курсоры обхода
RETENTION_DAYS=30
# Старые версии сырых ответов Metacritic, последняя по каждой игре остаётся всегда
RAW_RETENTION_DAYS=90
CLEANUP_HOUR=4


# ============================================================================
# Логи, ошибки и метрики
# ============================================================================

# text для чтения глазами локально, в compose по умолчанию json
LOG_FORMAT=text
LOG_LEVEL=INFO

# Sentry или совместимый сервис (GlitchTip), пусто: исключения никуда не отправляются
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Порты метрик Prometheus во внутренней сети: в compose 9100 и 9101, вне Docker 0 (не поднимать)
WORKER_METRICS_PORT=0
WEB_METRICS_PORT=0


# ============================================================================
# Тревоги (Alertmanager)
# ============================================================================

# Telegram: токен бота от @BotFather и id чата (у групп начинается с минуса)
# Пусто: тревоги видны только в интерфейсе Alertmanager
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сторожевой сигнал: адрес пинга внешнего сервиса (healthchecks.io, Dead Man's Snitch, Cronitor)
# Alertmanager шлёт его раз в минуту, сервис тревожит, если пинги пропали: так видно падение
# всего сервера. Пусто: не слать
DEADMAN_PING_URL=


# ============================================================================
# Бэкапы
# ============================================================================

# Ежедневный pg_dump в BACKUP_HOUR по TIMEZONE с проверкой восстановления, копии в томе backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Копии во внешнее S3-совместимое хранилище (docker compose --profile offsite up -d)
# Дампы шифруются age перед отправкой. Ключ создавать НЕ на сервере: age-keygen -o backup-key.txt,
# сюда только открытый ключ age1… (несколько через запятую). Без него ничего не выгружается
BACKUP_AGE_RECIPIENTS=
BACKUP_REMOTE=offsite:metacritic-backups
# Доступ к хранилищу для rclone: провайдер (AWS, Cloudflare, Other…), адрес, регион, ключи
RCLONE_CONFIG_OFFSITE_PROVIDER=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=


# ============================================================================
# Образы для деплоя
# ============================================================================
# CI публикует образы в GHCR, на сервере: docker compose pull && docker compose up -d

IMAGE_PREFIX=ghcr.io/dimirka/metacritic-games
IMAGE_TAG=latest
