# dev или prod: в prod cookie только по HTTPS, /docs выключены, Caddy ставит HSTS
ENV=dev

# Логи: text для локальной разработки, в compose по умолчанию json
LOG_FORMAT=text
LOG_LEVEL=INFO
# Sentry или совместимый (GlitchTip): пусто — исключения никуда не отправляются
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Тревоги в Telegram через Alertmanager: токен от @BotFather и id чата (у групп с минусом).
# Пусто: тревоги видны только в интерфейсе Alertmanager
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POSTGRES_USER=metacritic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metacritic
# Роли с минимальными правами для web и worker, создаёт python -m app db-roles (сервис migrate)
# Пароли без спецсимволов URL, например openssl rand -hex 24
APP_WEB_DB_PASSWORD=change-me-web
APP_WORKER_DB_PASSWORD=change-me-worker

# Для запуска вне Docker; в compose переопределяется на хост db
DATABASE_URL=postgresql+asyncpg://metacritic:change-me@localhost:5432/metacritic

# Домен для Caddy (HTTPS выпускается автоматически); локально localhost
DOMAIN=localhost

TIMEZONE=Europe/Moscow
BATCH_SIZE=20
CRAWL_INTERVAL_MINUTES=60
CRAWL_ON_START=true
# Очередь задач. WORKER_ID пустой: hostname:pid экземпляра
WORKER_ID=
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=5
JOB_POLL_SECONDS=5
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
# Параллельность по видам задач. Metacritic: один процесс-обработчик, лимит частоты в памяти
SCRAPE_CONCURRENCY=3
SUMMARY_CONCURRENCY=2
EMBED_CONCURRENCY=1
LETSPLAY_CONCURRENCY=1
# Сколько ждать текущие задачи при остановке; stop_grace_period в compose должен быть больше
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Файл для healthcheck воркера, в compose задан сам, вне Docker не нужен
WORKER_HEALTH_FILE=
# Порт метрик Prometheus воркера: в compose 9100, вне Docker 0 (не поднимать)
WORKER_METRICS_PORT=0
# Автоматы: после стольких сбоев подряд задачи откладываются на OPEN_SECONDS без траты попыток
BREAKER_METACRITIC_THRESHOLD=5
BREAKER_METACRITIC_OPEN_SECONDS=600
BREAKER_LLM_THRESHOLD=3
BREAKER_LLM_OPEN_SECONDS=1800
# Сколько ждать результат пробной задачи после открытия
BREAKER_PROBE_SECONDS=60

# Кнопка «Запустить сейчас» доступна не чаще, чем раз в столько минут после старта прошлого прохода
MANUAL_RUN_COOLDOWN_MINUTES=10

# Ежедневная очистка в CLEANUP_HOUR по TIMEZONE, дни хранения, 0: не чистить.
# RETENTION_DAYS: завершённые задачи, проходы с их записями, курсоры обхода.
# RAW_RETENTION_DAYS: старые версии сырых ответов, последняя по игре остаётся всегда
RETENTION_DAYS=30
RAW_RETENTION_DAYS=90
CLEANUP_HOUR=4

# Вход в служебную часть, пользователей создаёт python -m app users
SESSION_TTL_HOURS=12
# Неудачи с одного IP под одним логином: после LOGIN_MAX_ATTEMPTS вход с этого IP закрыт на окно
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Неудачи под одним логином с любых IP: после LOGIN_DELAY_AFTER каждая попытка ждёт 2, 4, 8…
# секунд, не больше LOGIN_DELAY_MAX_SECONDS. На каждой LOGIN_ALERT_THRESHOLD-й неудаче
# предупреждение в журнал, серии видны в мониторе
LOGIN_DELAY_AFTER=5
LOGIN_DELAY_MAX_SECONDS=60
LOGIN_ALERT_THRESHOLD=10
# Второй фактор TOTP для администраторов: пусто = обязателен при ENV=prod.
# Включить: python -m app users totp <login>
ADMIN_TOTP_REQUIRED=

# Запросов в минуту с одного IP: каталог, JSON API каталога, страница входа
RATE_LIMIT_CATALOG_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=20

REQUEST_DELAY=1.0

# LLM для резюме отзывов
# Claude: LLM_PROVIDER=anthropic, ключ в ANTHROPIC_API_KEY
LLM_PROVIDER=anthropic
SUMMARY_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# OpenAI-совместимый провайдер, например бесплатный Gemini.
# У gemini-3.8-flash на бесплатном тарифе всего 20 запросов в сутки, для обхода мало,
# квоты по моделям: https://aistudio.google.com/rate-limit
# LLM_PROVIDER=openai
# SUMMARY_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=ключ из https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=
# Цена модели в $ за миллион токенов для оценки расходов в мониторе, 0: не показывать
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

YOUTUBE_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models
